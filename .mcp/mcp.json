{
  "mcpServers": {
    "ai-guides": {
      "command": "npx",
      "args": [
        "-y",
        "@modelcontextprotocol/server-filesystem",
        ".github/ai"
      ],
      "description": "Read-only MCP filesystem access to the AI collaboration guides under .github/ai/.",
      "disabled": false
    },
    "graphify": {
      "type": "stdio",
      "command": "uvx",
      "args": [
        "--from",
        "graphifyy",
        "python",
        "-m",
        "graphify.serve",
        "graphify-out/graph.json"
      ]
    },
    "code-review-graph": {
      "type": "stdio",
      "command": "uvx",
      "args": [
        "code-review-graph",
        "serve"
      ]
    }
  }
}
