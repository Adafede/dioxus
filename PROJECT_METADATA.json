{
  "name": "dioxus-apps",
  "primary_language": "Rust",
  "secondary_languages": [
    "Markdown",
    "JSON",
    "YAML"
  ],
  "packages": [
    {
      "name": "index",
      "kind": "wasm app",
      "path": "apps/index",
      "entrypoint": "src/main.rs"
    },
    {
      "name": "json-count-rs",
      "kind": "wasm app",
      "path": "apps/json-count-rs",
      "entrypoint": "src/main.rs"
    },
    {
      "name": "mgf-precursor-erro-rs",
      "kind": "wasm app",
      "path": "apps/mgf-precursor-erro-rs",
      "entrypoint": "src/lib.rs"
    },
    {
      "name": "lotus-api",
      "kind": "native http api",
      "path": "apps/lotus-api",
      "entrypoint": "src/main.rs"
    },
    {
      "name": "lotus-explore-rs",
      "kind": "wasm app",
      "path": "apps/lotus-explore-rs",
      "entrypoint": "src/main.rs"
    },
    {
      "name": "lotus",
      "kind": "shared library",
      "path": "crates/lotus",
      "entrypoint": "src/lib.rs"
    },
    {
      "name": "upload",
      "kind": "shared library",
      "path": "crates/upload",
      "entrypoint": "src/lib.rs"
    },
    {
      "name": "ui",
      "kind": "shared library",
      "path": "crates/ui",
      "entrypoint": "src/lib.rs"
    },
    {
      "name": "lipid-selecto-rs",
      "kind": "wasm app",
      "path": "apps/lipid-selecto-rs",
      "entrypoint": "src/main.rs"
    },
    {
      "name": "smellfish-rs",
      "kind": "wasm app",
      "path": "apps/smellfish-rs",
      "entrypoint": "src/lib.rs"
    }
  ],
  "agent_docs": {
    "guide": "AI_AGENT_GUIDE.md",
    "contributing": ".github/CONTRIBUTING_AI.md",
    "skills_index": "apps/lotus-explore-rs/docs/skills/README.md",
    "skills_root": "apps/lotus-explore-rs/SKILLS.md",
    "architecture": "apps/lotus-explore-rs/docs/ARCHITECTURE.md"
  },
  "validation_commands": [
    "cargo check --workspace --all-targets --locked",
    "cargo test --workspace --all-targets --locked",
    "cargo clippy --workspace --all-targets --locked -- -D warnings",
    "cargo doc --workspace --no-deps --locked"
  ]
}
