# Normalise text files in the repository and in the working tree, so that a
# diff is a change in content rather than in line endings or in an editor's
# whitespace.
# https://git-scm.com/docs/gitattributes

* text=auto eol=lf

# Binary. Nothing here should ever produce a textual diff for these, and
# `text=auto` would otherwise ask Git to guess.
*.wasm binary
*.zip binary
*.gz binary
*.png binary
*.jpg binary
*.svg text eol=lf

# `Cargo.lock` is generated but committed, and it must be committed: every task
# runs `--locked`, so a lockfile that drifts per machine is a build that differs
# per machine. `-diff` because a 20 000-line generated diff is unreadable.
Cargo.lock text eol=lf -diff linguist-generated=true

# The generated crate READMEs: committed, and regenerated by
# `cargo make readme-write` from each crate's `README.tpl` and module docs.
# Marked generated so a diff view and `git blame` both say so.
apps/*/README.md linguist-generated=true
crates/*/README.md linguist-generated=true

# The knowledge graph is a generated artefact with an external merge driver:
# two people regenerating it on different commits produce a file that merges as
# one node rather than as a conflict over 20 000 lines.
graphify-out/graph.json merge=graphify

# Shell scripts must keep LF even on Windows: a CRLF shebang is not a shebang.
# `mk` has no extension, so it is named rather than matched.
*.sh text eol=lf
mk text eol=lf

# Anything under `target/` and the Dioxus CLI output is build output. The rules
# below are redundant with `.gitignore` and are here because `.gitignore` is not
# a lock -- `git add -f` overrides it, and these hold regardless.
/target/** -diff -merge linguist-generated=true
/apps/*/dist/** -diff -merge linguist-generated=true
/apps/*/.dioxus/** -diff -merge linguist-generated=true
/mutants.out/** -diff -merge linguist-generated=true
