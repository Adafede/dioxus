{
  "name": "lotus-explore-rs",
  "private": true,
  "scripts": {
    "build:css": "npx @tailwindcss/cli -i ./tailwind/styles.css -o ./public/assets/lotus-explore.css --minify",
    "watch:css": "npx @tailwindcss/cli -i ./tailwind/styles.css -o ./public/assets/lotus-explore.css --watch",
    "dev": "dx serve --package lotus-explore-rs --platform web --wasm-split",
    "build:release": "dx build --package lotus-explore-rs --platform web --release --debug-symbols=false --wasm-split"
  },
  "devDependencies": {
    "@tailwindcss/cli": "^4.3.3",
    "tailwindcss": "^4.3.3"
  }
}
