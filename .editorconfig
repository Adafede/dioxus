# EditorConfig: what every editor should agree on, so that a contributor's editor
# and `cargo make fmt-check` do not disagree about a character.
# https://editorconfig.org
#
# Only the settings that are not already implied by a formatter are here. Indent
# width and line width for Rust are `rustfmt.toml`'s business, and repeating
# them would be two answers to the same question.

root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true

# The repository's own markdown and prose is written at 80 columns, which is
# also what `panache format` does to the generated crate READMEs. Without this
# an editor reflows a README into 100-column prose and `readme-check` then
# reports drift that is only a wrapping difference.
[*.md]
max_line_length = 80

# TOML is `tombi`'s business; an editor that reformats it differently from
# `tombi format` produces a diff on every save.
[*.toml]
indent_size = 2

[*.{yml,yaml}]
indent_size = 2

[Makefile.toml]
indent_size = 2

# `.sh` files are two-space indented, which is what shell style guides ask for
# and what the files under `make/scripts/` already use.
[*.sh]
indent_size = 2

# Generated assets. Third-party and large; an editor must not try to reflow or
# trim them, and `end-of-file-fixer` excludes them for the same reason.
[apps/*/public/assets/**]
insert_final_newline = unset
trim_trailing_whitespace = unset

# `Cargo.lock` is generated by Cargo and `Cargo.toml` is formatted by tombi.
[Cargo.lock]
insert_final_newline = true
